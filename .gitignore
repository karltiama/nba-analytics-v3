# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.venv/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local reference notes (not part of shipped code)
/notes/

# Local ops / certification run artifacts (regenerable; do not commit)
/tmp/

# Ops design/certification reports (regenerable; local audit trail only)
/reports/

# Regenerable context-projection ops status / cert dumps
# (frozen model/window manifests stay tracked)
lib/context-projection/artifacts/*-arm-status.json
lib/context-projection/artifacts/*-implementation-certification.*
lib/context-projection/artifacts/*-sample-size-feasibility.json
lib/context-projection/artifacts/*-activation-readiness.*
lib/context-projection/artifacts/context-projection-prospective-operations.json

# Lambda / Terraform build outputs
lambda/**/.package/
infra/*.zip

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local Owls Insight backfill checkpoints (trial resume state)
/data/owls-insight/runs/

# Env files (can opt-in for committing if needed)
.env*
!.env.example

# Local Terraform var files with secrets (also ignored under infra/)
*.tfvars
!**/terraform.tfvars.example
!infra/terraform.tfvars.example
*.tfplan

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
