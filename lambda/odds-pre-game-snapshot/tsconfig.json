{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node"
  },
  "include": ["index.ts", "acquire.ts", "normal-path.ts", "season-eligibility.ts", "canary-limits.ts", "bdl-live-rate-limit.ts", "bdl-live-rate-limit-dynamo.ts", "request-budget.ts", "overlap-claim.ts", "collection-planner.ts", "safety-policy.ts"],
  "exclude": ["node_modules", "dist"]
}

