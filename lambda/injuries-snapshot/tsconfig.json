{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node"
  },
  "include": ["index.ts", "leave-report.ts", "ingest-plan.ts", "bdl-live-rate-limit.ts", "bdl-live-rate-limit-dynamo.ts"],
  "exclude": ["node_modules", "dist"]
}
