# PREPARED ONLY (STEP 14D.DATA2A). NOT APPLIED. Not loaded by Terraform:
# lives outside the infra/ root module and uses a .example extension.
#
# Minimum S3 permissions for lib/acquisition/archive.ts + s3-store.ts:
#   s3:PutObject  -> conditional create (IfNoneMatch "*")
#   s3:GetObject  -> GetObject readback AND HeadObject (HEAD is authorized by s3:GetObject)
# Deliberately absent: s3:DeleteObject, s3:DeleteObjectVersion, s3:PutObjectAcl,
# s3:PutLifecycleConfiguration, s3:ListBucket.
#   Without s3:ListBucket a HEAD on a missing key returns 403 instead of 404. The archive
#   writer only HEADs after a successful create or a 412 (object exists), so 404-vs-403
#   is never needed; a 403 surfaces as ARCHIVE_FAILED (fail-closed).
#
# Scope each collector role to ONLY its own endpoint families. Example for a future
# player-props wiring phase (DATA2B); repeat per role/family when that phase lands.

resource "aws_iam_role_policy" "lambda_player_props_worker_acq_archive" {
  count = var.nba_data_bucket_name != "" ? 1 : 0
  name  = "player-props-worker-acq-archive"
  role  = aws_iam_role.lambda_player_props_execution.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid    = "AcqArchiveCreateAndReadback"
        Effect = "Allow"
        Action = [
          "s3:PutObject",
          "s3:GetObject"
        ]
        Resource = "arn:aws:s3:::${var.nba_data_bucket_name}/${var.nba_raw_prefix}/source=balldontlie/league=nba/season=*/entity=acq_odds_player_props/*"
      }
    ]
  })
}

# Optional hardening (bucket policy, separate ops decision; not part of DATA2A):
# deny s3:DeleteObject / s3:DeleteObjectVersion on "${var.nba_raw_prefix}/*/entity=acq_*/*"
# for every principal except a break-glass role.
