# PREPARED ONLY (STEP 14D.DATA2E.1). NOT APPLIED. Not loaded by Terraform (.example extension).
#
# Activation of the game-status-sync immutable archive (lib/games/status-sync-acquisition.ts)
# needs BOTH parts below in infra/game-status-sync.tf, plus a rebuilt Lambda package.
# Until then the frozen Lambda never reaches the archive path (freeze skip runs first), and
# a thawed Lambda without NBA_DATA_BUCKET fails closed before any provider call.
#
# Part 1 - IAM: create + readback on acq_games only.
#   s3:PutObject -> conditional create (IfNoneMatch "*")
#   s3:GetObject -> GetObject readback AND HeadObject (HEAD is authorized by s3:GetObject)
# Deliberately absent: s3:DeleteObject*, s3:PutObjectAcl, s3:ListBucket.
#   Without s3:ListBucket a HEAD on a missing key returns 403 instead of 404. The archive
#   writer only HEADs after a successful create or a 412, so 404-vs-403 is never needed;
#   a 403 surfaces as ARCHIVE_FAILED (fail-closed, zero analytics.games writes).

resource "aws_iam_role_policy" "game_status_sync_acq_archive" {
  count = var.game_status_sync_create && var.nba_data_bucket_name != "" ? 1 : 0
  name  = "${var.game_status_sync_lambda_function_name}-acq-archive"
  role  = aws_iam_role.lambda_game_status_sync_execution[0].id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid    = "AcqGamesArchiveCreateAndReadback"
        Effect = "Allow"
        Action = [
          "s3:PutObject",
          "s3:GetObject"
        ]
        Resource = "arn:aws:s3:::${var.nba_data_bucket_name}/${var.nba_raw_prefix}/source=balldontlie/league=nba/season=*/entity=acq_games/*"
      }
    ]
  })
}

# Part 2 - env: add to the LAST merge map of aws_lambda_function.game_status_sync
# (after var.game_status_sync_lambda_env so it cannot be overridden by tfvars):
#
#   NBA_DATA_BUCKET                              = var.nba_data_bucket_name
#   NBA_RAW_PREFIX                               = var.nba_raw_prefix
#   GAME_STATUS_SYNC_PRESEASON_DISCOVERY_ENABLED = "0"
#
# Same shared variables as infra/lambda.tf (NBA_DATA_BUCKET / NBA_RAW_PREFIX). The preseason
# flag stays "0" until a separate activation step; flipping it adds a second /v1/games query
# (season_type=preseason) per cycle, so review game_status_sync_lambda_timeout (2 queries x
# up to 3 pages each under the shared limiter) at that time.
