# Copy to terraform.tfvars and set real values. Do not commit terraform.tfvars.
# Or pass via environment: export TF_VAR_aws_region=us-east-1

# Master ingestion safety gate (Step 13C.1 / 13I.2).
# Not a resource-creation flag. Per-family enable_* / cron lists may still CREATE
# EventBridge / Scheduler resources; those stay DISABLED unless this is true AND
# the family *_execution_enabled flag is true.
# Frozen apply: keep false even if stale tfvars still say enable_schedule = true.
live_ingestion_enabled = false

# Family execution (activation). Defaults false so a global thaw cannot start work.
nightly_execution_enabled = false
odds_execution_enabled = false
injuries_execution_enabled = false
player_props_execution_enabled = false
boxscore_execution_enabled = false
game_status_sync_execution_enabled = false
postgame_execution_enabled = false

# CODE_ONLY family creation. Independent of live_ingestion_enabled.
# Frozen baseline: keep false. Authorized status-sync deploy: game_status_sync_create = true
# while live_ingestion_enabled remains false (Lambda exists, no execution).
game_status_sync_create = false
postgame_create = false

aws_region          = "us-east-1"
lambda_function_name = "nightly-bdl-updater"
lambda_timeout      = 300
lambda_memory_size  = 512

# Set to true to run the Lambda daily on schedule (e.g. 08:00 UTC).
enable_schedule = false
schedule_cron   = "cron(0 8 * * ? *)"

# BALLDONTLIE key — AWS source of truth is this untracked tfvars file.
# Use the SAME BALLDONTLIE_API_KEY in nightly / odds / injuries / props env maps.
# terraform apply overwrites Lambda environment from these maps; do not set the
# key only in the AWS console (the next apply will replace it).
# Before apply: npx tsx scripts/ops/2026-bdl-credential-alignment.ts
# Local CLI canaries read repo-root .env (BALLDONTLIE_API_KEY; typo alias fallback).
# There is no Secrets Manager / SSM lookup.

# Required for nightly-bdl-updater. Use real values in terraform.tfvars or TF_VAR_lambda_env.
lambda_env = {
  SUPABASE_DB_URL       = "postgresql://postgres.PROJECT:PASSWORD@REGION.pooler.supabase.com:6543/postgres"
  BALLDONTLIE_API_KEY   = "your_balldontlie_api_key"
  # Offseason freeze (no provider calls / writes). Tip-off: live_api / 0 / 0.
  DATA_MODE             = "replay"
  OFFSEASON_MODE        = "1"
  CRON_DRY_RUN          = "1"
  # Optional:
  # BALLDONTLIE_REQUEST_DELAY_MS = "200"
  # MAX_RETRIES                  = "3"
}

# Account-level BDL limiter. Applied to nightly/odds/injuries/props worker.
# activation-canary safety rate (13s / burst 1) until paid GOAT entitlement is confirmed.
# This is the Court Context operating rate, not the provider entitlement.
# bdl_rate_limit_table_name          = "nba-bdl-rate-limit"
# bdl_rate_limit_interval_ms         = 13000
# bdl_rate_limit_max_requests        = 1
# bdl_rate_limit_burst               = 1
# bdl_rate_limit_acquire_timeout_ms  = 90000
# player_props_worker_reserved_concurrency = 4
# player_props_apply_reserved_concurrency  = false

# -----------------------------------------------------------------------------
# Odds pre-game snapshot Lambda
# -----------------------------------------------------------------------------
odds_lambda_function_name = "odds-pre-game-snapshot"
odds_lambda_timeout        = 300
odds_lambda_memory_size   = 512
odds_enable_schedule      = true
# Single run (e.g. 09:00 ET) when odds_schedule_crons is not set:
# odds_schedule_cron = "cron(0 14 * * ? *)"
# Every 30 min 10am-12pm ET (UTC 15:00, 15:30, 16:00, 16:30, 17:00):
odds_schedule_crons = [
  "cron(0 15 * * ? *)",
  "cron(30 15 * * ? *)",
  "cron(0 16 * * ? *)",
  "cron(30 16 * * ? *)",
  "cron(0 17 * * ? *)",
]

# Required for odds-pre-game-snapshot. Use real values in terraform.tfvars.
odds_lambda_env = {
  SUPABASE_DB_URL     = "postgresql://postgres.PROJECT:PASSWORD@REGION.pooler.supabase.com:6543/postgres"
  BALLDONTLIE_API_KEY = "your_balldontlie_api_key"
  DATA_MODE           = "replay"
  OFFSEASON_MODE      = "1"
  CRON_DRY_RUN        = "1"
  # Optional:
  # PREFERRED_VENDOR = "draftkings"
}

# -----------------------------------------------------------------------------
# Injuries snapshot Lambda
# -----------------------------------------------------------------------------
injuries_lambda_function_name = "injuries-snapshot"
injuries_lambda_timeout       = 120
injuries_lambda_memory_size   = 256
injuries_enable_schedule      = false
injuries_schedule_cron        = "cron(0 13,18,22 * * ? *)"

# Required for injuries-snapshot. Use real values in terraform.tfvars.
injuries_lambda_env = {
  SUPABASE_DB_URL     = "postgresql://postgres.PROJECT:PASSWORD@REGION.pooler.supabase.com:6543/postgres"
  BALLDONTLIE_API_KEY = "your_balldontlie_api_key"
  DATA_MODE           = "replay"
  OFFSEASON_MODE      = "1"
  CRON_DRY_RUN        = "1"
}

# -----------------------------------------------------------------------------
# Player props ingestion Lambda (EventBridge Scheduler)
# Set player_props_enable_schedule = true so the Lambda runs and fills analytics.player_props_current.
# Without this, the player page sidebar has no props (empty "All stats" dropdown).
# -----------------------------------------------------------------------------
player_props_lambda_function_name = "nba-player-props-ingestion-lambda"
player_props_lambda_timeout       = 300
player_props_lambda_memory_size   = 512
player_props_enable_schedule      = true
player_props_schedule_expression  = "rate(30 minutes)"

# Optional: run only 9am-12pm ET every 30 min (UTC 14:00, 14:30, 15:00, 15:30, 16:00, 16:30, 17:00). When set, overrides rate above.
player_props_schedule_crons = [
  "cron(0 14 * * ? *)",
  "cron(30 14 * * ? *)",
  "cron(0 15 * * ? *)",
  "cron(30 15 * * ? *)",
  "cron(0 16 * * ? *)",
  "cron(30 16 * * ? *)",
  "cron(0 17 * * ? *)",
]

# Required for player-props Lambda. Use real values in terraform.tfvars.
# Optional: INCLUDE_TOMORROW=true to also fetch props for tomorrow's games (recommended so upcoming games get lines).
player_props_lambda_env = {
  BALLDONTLIE_API_KEY = "your_balldontlie_api_key"
  SUPABASE_DB_URL     = "postgresql://postgres.PROJECT:PASSWORD@REGION.pooler.supabase.com:6543/postgres"
  DATA_MODE           = "replay"
  OFFSEASON_MODE      = "1"
  CRON_DRY_RUN        = "1"
  # INCLUDE_TOMORROW   = "true"
  # Optional: override defaults from infra/lambda.tf for raw payload capture policy.
  # STORE_PROP_RAW_JSON       = "false"
  # PROP_RAW_JSON_SAMPLE_RATE = "0"
}

# -----------------------------------------------------------------------------
# Boxscore scraper Lambda (Basketball-Reference HTML)
# Schedule default off. Opening week: boxscore_enable_schedule = true plus live_api / 0 / 0.
# -----------------------------------------------------------------------------
boxscore_lambda_function_name = "boxscore-scraper"
boxscore_lambda_timeout       = 900
boxscore_lambda_memory_size   = 1024
boxscore_enable_schedule      = false
boxscore_schedule_cron        = "cron(0 8 * * ? *)"

boxscore_lambda_env = {
  SUPABASE_DB_URL      = "postgresql://postgres.PROJECT:PASSWORD@REGION.pooler.supabase.com:6543/postgres"
  DATA_MODE            = "replay"
  OFFSEASON_MODE       = "1"
  CRON_DRY_RUN         = "1"
  # BBREF_SCRAPE_DELAY_MS = "4000"
  # MAX_GAMES_PER_RUN     = "50"
}

# 13C.3B activation (status-sync only). Keep every other *_execution_enabled false.
# live_ingestion_enabled = true
# game_status_sync_create = true
# game_status_sync_execution_enabled = true
# game_status_sync_enable_schedule = true
# game_status_sync_schedule_expression = "rate(15 minutes)"
# Status-sync DATA_MODE/OFFSEASON/CRON_DRY_RUN are family-gated in HCL last-merge.
# Do not put DATA_MODE=live_api in nightly/odds/injuries/props/boxscore env maps.

