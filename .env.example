# Copy to `.env.local` for local Next.js development.
# Never commit real secrets. See docs/deployment-checklist.md for production.

# --- Next.js + Supabase (required for app/auth) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Postgres (API routes, scripts, AWS Lambdas) ---
# Use Supabase connection string; pooler often recommended for serverless.
SUPABASE_DB_URL=

# --- Vercel Cron (paper settlement) ---
# CRON_SECRET=
# PAPER_SETTLE_CRON_SECRET=

# --- Optional: AI routes (betting insights) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Entitlements (local Founding Pro testing only; ignored when NODE_ENV=production) ---
# ENTITLEMENT_DEV_GRANT_USER_IDS=

# --- Stripe billing (WP6.3 test/sandbox only; server-only; never expose to the client) ---
# Do not put live sk_live_ keys here until live billing is separately approved.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_FOUNDING_PRO_PRICE_ID=price_...
# APP_BASE_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- BallDontLie + ingestion (scripts / Lambdas; not needed for UI-only local dev) ---
# BALLDONTLIE_API_KEY=
# Typo alias still read by some code paths:
# BALDONTLIE_API_KEY=
# BALLDONTLIE_REQUEST_DELAY_MS=200
# MAX_RETRIES=3
# PREFERRED_VENDOR=draftkings

# --- Optional: other scripts ---
# ODDS_API_KEY=
# AWS_REGION=us-east-1

# --- Runtime data mode (offseason toggle) ---
# live_api: normal in-season behavior (calls provider APIs)
# replay: run schedules/pipelines without provider API calls
# manual_csv: reserved for manual/local data feeds
# Fail-safe: missing DATA_MODE is not live (skip provider mutations). Destructive prune is separate (below).
# DATA_MODE=live_api
# OFFSEASON_MODE=0
# CRON_DRY_RUN=0

# Offseason freeze (schedulers stay up; Lambdas and Vercel crons no-op):
# DATA_MODE=replay
# OFFSEASON_MODE=1
# CRON_DRY_RUN=1

# --- Live BDL account-level rate limit (AWS workers; ignored while freeze skips HTTP) ---
# Coordination backend is dynamodb in AWS. Local/replay tests use memory.
# activation-canary safety rate until paid GOAT entitlement is confirmed.
# BDL_RATE_LIMIT_BACKEND=dynamodb
# BDL_RATE_LIMIT_TABLE=nba-bdl-rate-limit
# BDL_RATE_LIMIT_INTERVAL_MS=13000
# BDL_RATE_LIMIT_MAX_REQUESTS=1
# BDL_RATE_LIMIT_BURST=1
# BDL_RATE_LIMIT_ACQUIRE_TIMEOUT_MS=90000
# Do not set BDL_RATE_LIMIT_ALLOW_FAST=1 in production.

# --- Props prune cron (/api/cron/prune-props) ---
# Destructive deletes require ALL of:
#   PRUNE_ENABLED=1
#   DATA_MODE=live_api
#   OFFSEASON_MODE=0
#   CRON_DRY_RUN=0
# Missing any of these = no deletes (fail-safe). Do NOT set PRUNE_ENABLED in offseason.
# PRUNE_ENABLED=0
#
# Max-delete caps (defaults shown). Seasonal daily prune should stay under these.
# For intentional large cleanups only: PRUNE_ALLOW_LARGE_DELETE=1
# PRUNE_MAX_DELETE_PERCENT=35
# PRUNE_MAX_DELETE_ROWS=200000
# PRUNE_ALLOW_LARGE_DELETE=0
#
# Raw prune also requires S3 archive verification (NBA_DATA_BUCKET + AWS creds on Vercel).

# CURRENT_ANALYTICS_SEASON=2025
# Accepts 2025 or 2025-26. App/queries stay on this start year.
# Flip to 2026 only after 2026-27 schedule + averages are seeded.
# (July calendar would already be 2026 and empty the dashboards.)

# --- Optional product analytics (Umami) ---
# Unset locally: trackEvent is a no-op (do not force localhost sending).
# Production: set both to enable pageviews + custom events.
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js

# --- NBA data lake (archive scripts) ---
# Target S3 bucket for raw/curated/features/backtests artifacts.
# Required by scripts/archive/* (e.g. archive-existing-season-to-s3.ts).
# NBA_DATA_BUCKET=nba-analytics-data
# Top-level prefix under which raw exports live (default: raw).
# NBA_RAW_PREFIX=raw
